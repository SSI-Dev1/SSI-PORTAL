# Copy to .env (never commit .env). All VITE_* values are embedded in the
# browser bundle at build time — they must be public keys only.

# Supabase project (Dashboard → Project Settings → API).
# Leave empty to run the prototype with built-in demo accounts and local data.
VITE_SUPABASE_URL=https://goiyhrlhczygeweykwqq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Built-in prototype accounts. Defaults to true only when Supabase is not configured.
# Set to false for any public deployment.
VITE_ENABLE_DEMO_ACCOUNTS=

# Turn on after enabling Google in Supabase → Authentication → Providers.
VITE_ENABLE_GOOGLE_AUTH=false

# Optional: where Supabase/Google redirect after sign-in (defaults to the current site URL).
# Must also be listed in Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_AUTH_REDIRECT_URL=
