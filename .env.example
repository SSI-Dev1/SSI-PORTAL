# Copy to .env (never commit .env). Every VITE_* value is embedded in the public
# browser bundle at build time — only browser-safe values belong here.
# NEVER put the Supabase service-role key, a database password, SMTP credentials or
# an OAuth client secret in this file.

# Supabase project (Dashboard → Project Settings → API). Required: without these the
# app refuses all sign-ins (there is no offline/demo login).
VITE_SUPABASE_URL=https://goiyhrlhczygeweykwqq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Turn on after enabling Google in Supabase → Authentication → Providers.
VITE_ENABLE_GOOGLE_AUTH=false

# Minutes of inactivity before automatic sign-out (minimum 5, default 30).
VITE_IDLE_TIMEOUT_MINUTES=30

# Optional: site URL used in auth emails / OAuth redirects (defaults to the current URL).
# Must be listed in Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_AUTH_REDIRECT_URL=
