{
  "name": "ssi-global-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "test:security": "bash supabase/tests/run.sh",
    "audit": "npm audit --omit=dev",
    "demo:sql": "esbuild scripts/gen-demo-sql.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-demo-sql.mjs --log-level=warning && node node_modules/.cache/gen-demo-sql.mjs"
  },
  "dependencies": {
    "@fontsource/lexend": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.13",
    "typescript": "5.5.4",
    "vite": "5.4.21"
  }
}
